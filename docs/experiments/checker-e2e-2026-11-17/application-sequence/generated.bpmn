<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://text2bpmn.app/bpmn" exporter="text2BPMN" exporterVersion="1.0">
  <bpmn:collaboration id="P1_Collaboration_1" name="Process Application">
    <bpmn:participant id="P1_Participant_1" name="Process Application" processRef="P1_Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="P1_Process_1" name="Process Application" isExecutable="false">
    <bpmn:laneSet id="P1_LaneSet_1">
      <bpmn:lane id="P1_Lane_1" name="Admin">
        <bpmn:flowNodeRef>P1_StartEvent_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Task_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_Task_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_EndEvent_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_StartEvent_s1" name="Receive application">
      <bpmn:outgoing>P1_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P1_Task_t1" name="Review application">
      <bpmn:incoming>P1_Flow_1</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P1_Task_t2" name="Pay applicant">
      <bpmn:incoming>P1_Flow_2</bpmn:incoming>
      <bpmn:outgoing>P1_Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P1_EndEvent_e1" name="End">
      <bpmn:incoming>P1_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_Flow_1" sourceRef="P1_StartEvent_s1" targetRef="P1_Task_t1" />
    <bpmn:sequenceFlow id="P1_Flow_2" sourceRef="P1_Task_t1" targetRef="P1_Task_t2" />
    <bpmn:sequenceFlow id="P1_Flow_3" sourceRef="P1_Task_t2" targetRef="P1_EndEvent_e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P1_BPMNDiagram_1">
    <bpmndi:BPMNPlane id="P1_BPMNPlane_1" bpmnElement="P1_Collaboration_1">
      <bpmndi:BPMNShape id="P1_Participant_1_di" bpmnElement="P1_Participant_1" isHorizontal="true">
        <dc:Bounds x="56" y="48" width="761" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Lane_1_di" bpmnElement="P1_Lane_1" isHorizontal="true">
        <dc:Bounds x="86" y="48" width="731" height="152" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_StartEvent_s1_di" bpmnElement="P1_StartEvent_s1">
        <dc:Bounds x="144" y="106" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="101" y="146" width="122" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Task_t1_di" bpmnElement="P1_Task_t1">
        <dc:Bounds x="260" y="84" width="157" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_Task_t2_di" bpmnElement="P1_Task_t2">
        <dc:Bounds x="497" y="84" width="148" height="80" />
