        <bpmndi:BPMNLabel>
          <dc:Bounds x="729" y="146" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_Flow_1_di" bpmnElement="P1_Flow_1">
        <di:waypoint x="180" y="124" />
        <di:waypoint x="232" y="124" />
        <di:waypoint x="260" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_2_di" bpmnElement="P1_Flow_2">
        <di:waypoint x="417" y="124" />
        <di:waypoint x="469" y="124" />
        <di:waypoint x="497" y="124" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_3_di" bpmnElement="P1_Flow_3">
        <di:waypoint x="645" y="124" />
