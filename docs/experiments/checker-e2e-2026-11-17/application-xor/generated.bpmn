        <di:waypoint x="834" y="190" />
        <di:waypoint x="862" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_6_di" bpmnElement="P1_Flow_6">
        <di:waypoint x="551" y="256" />
        <di:waypoint x="606" y="256" />
        <di:waypoint x="606" y="408" />
        <di:waypoint x="634" y="408" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_Flow_7_di" bpmnElement="P1_Flow_7">
